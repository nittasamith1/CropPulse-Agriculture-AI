# =====================================================
# CropPulse – AI-Powered Crop Intelligence Platform
# Environment Variables Template
# Copy this file to .env and fill in configuration
# =====================================================

# ----- Application -----
APP_NAME=CropPulse
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:8080

# ----- Security & JWT -----
SECRET_KEY=generate-a-secure-secret-key-of-at-least-64-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- MongoDB Atlas -----
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=croppulse

# ----- Open-Meteo Weather API -----
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=1800

# ----- AI Model Paths -----
DISEASE_MODEL_PATH=./ai_models/disease_model/disease_model.pth
SOIL_MODEL_PATH=./ai_models/soil_model/soil_model.pkl
DISEASE_CLASSES_PATH=./datasets/disease/disease_labels.csv
MODEL_CONFIDENCE_THRESHOLD=0.65

# ----- SMTP Email -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@croppulse.app
FROM_NAME=CropPulse
EMAIL_ENABLED=false

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# ----- Rate Limiting -----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----- File Upload -----
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_TEMP_DIR=./tmp/croppulse_uploads

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE=./logs/croppulse.log
